# Optional built-in Codex runtime tuning. Leave these commented to keep the
# bundled provider defaults.
# CODEX_MODEL=gpt-5-codex
# CODEX_REASONING_EFFORT=high
# Allowed values: low | medium | high | xhigh

# Optional native Mattermost adapter. These values are read by the host only
# and are never copied into agent/container configuration.
# MATTERMOST_URL=https://mattermost.example.com
# MATTERMOST_BOT_TOKEN=replace-with-a-non-production-token
# MATTERMOST_INSTANCE=primary
# MATTERMOST_ALLOW_MASS_MENTIONS=false

# Global host capacity. Two is the conservative default for Pi-class hosts;
# raise only after measuring memory and CPU under representative workloads.
# MAX_CONCURRENT_CONTAINERS=2
