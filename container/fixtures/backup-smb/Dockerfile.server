# Public synthetic transport fixture. It has no owner credentials or transferable application.
FROM debian@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
RUN rm -f /etc/apt/sources.list.d/debian.sources && \
    printf '%s\n' 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261007T000000Z trixie main' > /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends samba=2:4.22.11+dfsg-0+deb13u1 && \
    useradd --uid 1000 --no-create-home --shell /usr/sbin/nologin nanoclaw-cos-backup
COPY server.sh /fixture/server.sh
RUN chmod 0555 /fixture/server.sh
ARG SOURCE_COMMIT
ARG SOURCE_TREE
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT nanoclaw.source-tree=$SOURCE_TREE \
      nanoclaw.release-role=backup-smb-server-fixture nanoclaw.final-artifact=false
ENTRYPOINT ["/bin/sh", "/fixture/server.sh"]
