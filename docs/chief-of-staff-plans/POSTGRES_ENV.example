# DOCUMENTATION ONLY; proposed contract, not live configuration.
# Pi HOST SERVICE runtime environment. Keep real values outside Git and agent mounts.
# PostgreSQL is on a DIFFERENT machine on the private LAN.
COS_ENABLED=false
COS_PGHOST=db.internal.example
COS_PGPORT=5432
COS_PGDATABASE=chief_of_staff
COS_PGUSER=cos_runtime
COS_PGPASSWORD=__SET_PRIVATELY_IN_HOST_SERVICE_ENV__
COS_PGSSLMODE=verify-full
# COS_PGSSLROOTCERT=/etc/nanoclaw/postgres-ca.pem
COS_PG_ALLOW_PLAINTEXT=false
COS_PG_POOL_MAX=5
COS_PG_CONNECT_TIMEOUT_MS=3000
COS_PG_STATEMENT_TIMEOUT_MS=5000
COS_PG_QUERY_TIMEOUT_MS=7000
COS_PG_LOCK_TIMEOUT_MS=2000
COS_PG_IDLE_TIMEOUT_MS=30000
COS_PG_IDLE_TX_TIMEOUT_MS=10000
COS_PG_APPLICATION_NAME=nanoclaw-cos

# Only in the selected trusted Pi migration process, NOT daemon or worker:
# COS_PG_MIGRATION_USER=cos_migrator
# COS_PG_MIGRATION_PASSWORD=__SET_PRIVATELY_FOR_MIGRATION_ONLY__

# Independent external test database profile supplied to Mac test tooling.
# No automatic inheritance from runtime variables; same timeout/TLS suffixes supported.
# DBA supplies separate roles and protected cos_admin.target_identity marker.
# COS_TEST_PGHOST=db.internal.example
# COS_TEST_PGPORT=5432
# COS_TEST_PGDATABASE=chief_of_staff_test
# COS_TEST_PGUSER=cos_test_runtime
# COS_TEST_PGPASSWORD=__SET_PRIVATELY_FOR_TESTS_ONLY__
# COS_TEST_PGSSLMODE=verify-full
# COS_TEST_PGSSLROOTCERT=/etc/nanoclaw/postgres-ca.pem
# COS_TEST_PG_ALLOW_PLAINTEXT=false
# COS_TEST_PG_POOL_MAX=3
# COS_TEST_PG_MIGRATION_USER=cos_test_migrator
# COS_TEST_PG_MIGRATION_PASSWORD=__SET_PRIVATELY_FOR_TEST_MIGRATIONS_ONLY__
# COS_TEST_TARGET_ID=__DBA_PROVISIONED_TEST_TARGET_UUID__

# Separate test DB is optional only during eligible implementation disposal.
# Explicit --db-profile runtime-disposable requires Mac-supplied client env plus
# Pi-owned current lifecycle, target binding, maintenance lease and quiescence.
# Never copy/dump Pi secrets, silently switch profiles, install local Postgres,
# point tests at protected data, or pass these settings into image builds/workers.
# Runtime scoped migrations/deployments already have the owner's standing approval;
# automated safety checks and human PR merge requirements still apply.
